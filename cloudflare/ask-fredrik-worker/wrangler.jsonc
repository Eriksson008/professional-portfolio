// Wrangler configuration for the Ask Fredrik Worker.
// Everything here runs on the Cloudflare Workers Free plan — no paid
// features, no secrets, no API keys.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Renamed from `ask-fredrik-worker` on 2026-07-27. Cloudflare has no rename
  // operation - the name *is* the Worker's identity and its workers.dev
  // hostname - so that change was a deploy under this name plus a delete of the
  // old Worker. Three things did NOT move by themselves and had to be redone:
  //
  //   - the `ADMIN_ALLOWED_EMAILS` **secret**, which is stored per script name
  //     and does not follow a rename. Every admin endpoint fails closed without
  //     it, which looks like a code bug and is not one.
  //   - the Cloudflare Access application's destination, since Access protects
  //     a hostname. It was *edited* rather than recreated, so ACCESS_APP_AUD
  //     below is still correct; recreating it would have issued a new AUD.
  //   - the `VITE_ASK_FREDRIK_API_URL` GitHub Actions repository variable,
  //     which bakes this Worker's /ask URL into the portfolio bundle at build
  //     time and lives outside this repository entirely.
  //
  // The D1 database moved for free: it is bound by id, and the id is a property
  // of the database rather than of whatever Worker happens to bind it.
  //
  // The *directory* is still `cloudflare/ask-fredrik-worker/`, as is the npm
  // package name. That is deliberate: they describe "the Worker for Ask
  // Fredrik", not the deployed Worker's name, and renaming them would have
  // churned every workflow path for no gain.
  "name": "ask-fredrik",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",

  // D1 question log (D1 has a free tier). Created 2026-07-06 with
  // `npx wrangler d1 create ask-fredrik-db` (region ENAM). The id is not a
  // secret — it's unusable without account credentials. See README.md.
  "d1_databases": [
    {
      "binding": "ASK_FREDRIK_DB",
      "database_name": "ask-fredrik-db",
      "database_id": "20967ca0-cf71-4498-afed-a44368a31000"
    }
  ],

  // Workers AI (free daily allocation on Workers Free). The binding alone
  // does nothing — AI runs only when ASK_FREDRIK_AI_ENABLED below is "true".
  "ai": { "binding": "AI" },

  // The private admin dashboard, served by this Worker at /admin/ask-fredrik/.
  // Built (and gitignored) by the portfolio root's `npm run build:admin`;
  // requests that match no asset (e.g. /ask, /admin/logs) fall through to the
  // Worker. The /admin paths are gated by Cloudflare Access at the edge AND
  // re-validated in-Worker (src/access.ts).
  "assets": { "directory": "./public" },

  // Workers Logs in the Cloudflare dashboard (Workers & Pages →
  // ask-fredrik → Logs): invocation logs + console.warn output (AI
  // failures, D1 insert failures). Included on the Free plan. User questions
  // themselves are already logged to D1 — this adds operational visibility.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Non-secret tuning vars. All optional: the Worker applies these same
  // defaults in code when a var is unset or unparseable. Only the literal
  // string "true" enables AI ("false" or unset = curated answers only, no
  // model calls). Enabled 2026-07-06 at first deploy. See README.md.
  //
  // ACCESS_TEAM_DOMAIN + ACCESS_APP_AUD identify the Cloudflare Access
  // application protecting /admin (not secrets — the JWT is what proves
  // identity). Fill them in after creating the Access app (README ›
  // "Cloudflare Access setup"); while empty, every admin endpoint fails
  // closed with 503. The admin email allowlist is the ADMIN_ALLOWED_EMAILS
  // *secret* (wrangler secret put), never a var here.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://fredrikeriksson.cloudflareaccess.com",
    "ACCESS_APP_AUD": "3b4b8c76a02094b48bb0d9059d0f9b3c3a529ef82e9a6a5a04aec751eb0f3210",
    "ASK_FREDRIK_AI_ENABLED": "true",
    "ASK_FREDRIK_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "ASK_FREDRIK_AI_TIMEOUT_MS": "10000",
    "ASK_FREDRIK_MAX_OUTPUT_TOKENS": "250",
    "ASK_FREDRIK_RATE_LIMIT_WINDOW_SECONDS": "60",
    "ASK_FREDRIK_RATE_LIMIT_MAX_REQUESTS": "10",
    "ASK_FREDRIK_LOG_MAX_ROWS": "1000"
  }
}
