npm-debug.log*

# Private career/source material.
# The resources/ directory was REMOVED from this repo on 2026-07-27 — the canonical
# copy lives in the sibling private repo at ../resume-project/resources/. This entry
# stays as a backstop so a stray re-creation can never be committed to a public repo.
resources/
_source-materials/
*.local.pdf
# Legacy portfolio résumé is retained only in the private sibling repo.
public/resume-old.pdf

# Env / secrets
.env
.env.*
!.env.example

